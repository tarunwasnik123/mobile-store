# database connection string (for Mongoose)
MONGO_URI=mongodb://localhost:27017/mobile-store
# JWT secret (replace with a strong secret in production)
JWT_SECRET=your_jwt_secret_here
# Server port
PORT=5000

# Admin seed credentials (used by scripts/seed.js)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Cloudinary (required for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=cloudinary_api_key_here
CLOUDINARY_API_SECRET=cloudinary_api_secret_here
CLOUDINARY_FOLDER=mobile-store

# CORS: comma-separated list of allowed origins (frontend)
CLIENT_ORIGINS=http://localhost:5173

# Rate limiter 
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Cookie configuration
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE=604800000
